<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3
                              https://maven.apache.org/xsd/assembly-1.1.3.xsd">

    <id>dist</id>
    <formats>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/assembly/config/greywolf-core</directory>
            <outputDirectory>config/greywolf-core/${project.version}/</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/assembly/config/greywolf-devtools-shellfx</directory>
            <outputDirectory>config/greywolf-devtools-shellfx/${project.version}/</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/assembly/config/greywolf-system-terminal</directory>
            <outputDirectory>config/greywolf-system-terminal/${project.version}/</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/assembly/config/greywolf-devtools-weaverbird</directory>
            <outputDirectory>config/greywolf-devtools-weaverbird/${project.version}/</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/assembly/config/greywolf-system-navigator</directory>
            <outputDirectory>config/greywolf-system-navigator/${project.version}/</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/assembly/config/greywolf-devtools-base</directory>
            <outputDirectory>config/greywolf-devtools-base/${project.version}/</outputDirectory>
            <filtered>true</filtered>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${project.basedir}/assembly/config/log4j2.xml</source>
            <outputDirectory>config</outputDirectory>
            <filtered>true</filtered>
        </file>
        <file>
            <source>${project.basedir}/assembly/data/weaverbird-registry.xml</source>
            <outputDirectory>data</outputDirectory>
            <filtered>true</filtered>
        </file>
    </files>
</assembly>

